# ===== 应用 =====
SERVER_PORT=8123
LOG_LEVEL=INFO

# ===== 大模型（二选一）=====
# dashscope：阿里云百炼（兼容 OpenAI 协议）
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
CHAT_TEMPERATURE=0.7

# ollama：本地模型（LLM_PROVIDER=ollama 时生效）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:1b

# ===== 向量化 / 向量库 =====
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1536
# memory（内存向量库，默认） | pgvector（需要 DATABASE_URL）
VECTOR_STORE=memory
VECTOR_TABLE=vector_store
# LangGraph Checkpointer 使用（libpq 连接串）
DATABASE_URL=
# pgvector 使用（留空则复用 DATABASE_URL，驱动名自动补全）
VECTOR_DATABASE_URL=
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.5

# ===== 会话记忆 =====
# memory | file
CHAT_MEMORY=memory
CHAT_MEMORY_DIR=tmp/chat-memory
CHAT_MEMORY_MAX_MESSAGES=20

# ===== 智能体 =====
MANUS_MAX_STEPS=20
# memory | postgres（需要 DATABASE_URL + langgraph-checkpoint-postgres）
MANUS_CHECKPOINTER=memory

# ===== 工具 =====
FILE_SAVE_DIR=tmp
SEARCH_API_KEY=你的 SearchAPI Key
TERMINAL_TIMEOUT=60

# ===== MCP =====
MCP_SERVERS_CONFIG=mcp-servers.json
PEXELS_API_KEY=你的 Pexels API Key
MCP_SERVER_PORT=8127

# ===== 可选：阿里云百炼知识库应用 =====
DASHSCOPE_KNOWLEDGE_INDEX=运动健康助手
DASHSCOPE_APP_ID=
